{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "codex-workflow-hook",
            "statusMessage": "Arming explicit workflow",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "command": "codex-workflow-hook",
            "statusMessage": "Checking enforced workflow state",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "command": "codex-workflow-hook",
            "statusMessage": "Verifying workflow edit scope",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "codex-workflow-hook",
            "statusMessage": "Checking workflow completion",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
