{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "codex-workflow-hook",
            "statusMessage": "Arming explicit workflow",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "codex-workflow-hook",
            "statusMessage": "Binding workflow command to task",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "command": "codex-post-edit",
            "statusMessage": "Checking edited files",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
