{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "scripts/capture/capture.ts",
    "scripts/lint/check-unused.ts",
    "scripts/implement/codex-actor.ts",
    "scripts/implement/correction.ts",
    "scripts/implement/development.ts",
    "scripts/implement/publish.ts",
    "scripts/eval/eval.ts",
    "scripts/scoping/target.ts",
    "scripts/tests/runner.ts",
    "scripts/capture/verify.ts",
    "scripts/implement/verify-review.ts"
  ],
  "includeEntryExports": true,
  "ignoreDependencies": [
    "@textlint-rule/textlint-rule-no-invalid-control-character",
    "textlint-rule-ja-no-redundant-expression",
    "textlint-rule-no-nfd",
    "textlint-rule-no-zero-width-spaces"
  ],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error"
  },
  "framework": [
    {
      "name": "local-oxlint-plugin",
      "usedExports": [
        {
          "pattern": "scripts/lint/anti-slop/index.ts",
          "exports": [
            "default"
          ]
        }
      ],
      "enablers": [
        "oxlint"
      ]
    }
  ]
}
