{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "scripts/capture.ts",
    "scripts/check-unused.ts",
    "scripts/codex-actor.ts",
    "scripts/correction.ts",
    "scripts/development.ts",
    "scripts/knowledge.ts",
    "scripts/publish.ts",
    "scripts/skill-eval.ts",
    "scripts/target.ts",
    "scripts/test.ts",
    "scripts/verify-capture.ts",
    "scripts/verify-review.ts",
    "scripts/tests/**/*.test.ts"
  ],
  "includeEntryExports": true,
  "ignoreDependencies": [
    "@textlint-rule/textlint-rule-no-invalid-control-character",
    "textlint-rule-ja-no-redundant-expression",
    "textlint-rule-no-nfd",
    "textlint-rule-no-zero-width-spaces"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error"
  },
  "framework": [
    {
      "name": "local-oxlint-plugin",
      "usedExports": [
        {
          "pattern": "scripts/lint/anti-slop/index.ts",
          "exports": [
            "default"
          ]
        }
      ],
      "enablers": [
        "oxlint"
      ],
      "entryPoints": [
        "scripts/lint/anti-slop/index.ts"
      ]
    }
  ]
}
