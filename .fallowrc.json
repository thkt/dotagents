{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "scripts/capture/capture.ts",
    "scripts/ui/run.ts",
    "scripts/lint/fallow.ts",
    "scripts/feedback-loop/setup.ts",
    "scripts/feedback-loop/runtime.ts",
    "scripts/implement/codex-actor.ts",
    "scripts/implement/development.ts",
    "scripts/implement/publish.ts",
    "eval/light.ts",
    "scripts/scoping/target.ts",
    "scripts/tests/runner.ts",
    "scripts/tests/mutation/cli.ts",
    "scripts/tests/support/process-cleanup-probe.ts",
    "scripts/tests/support/process-cleanup-worker.ts",
    "scripts/tests/support/process-pipe-release-probe.ts",
    "scripts/tests/support/process-transparency-probe.ts",
    "scripts/capture/verify.ts",
    "scripts/implement/review-probe.ts",
    "scripts/implement/usage.ts",
    "docs/html/workflow-map.html",
    "docs/html/workflow-guide.html"
  ],
  "includeEntryExports": true,
  "ignorePatterns": [
    "output/**"
  ],
  "ignoreDependencies": [
    "@textlint-rule/textlint-rule-no-invalid-control-character",
    "textlint-rule-ja-no-redundant-expression",
    "textlint-rule-no-nfd",
    "textlint-rule-no-zero-width-spaces"
  ],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error"
  },
  "framework": [
    {
      "name": "local-oxlint-plugin",
      "usedExports": [
        {
          "pattern": "scripts/lint/local/index.ts",
          "exports": [
            "default"
          ]
        }
      ],
      "enablers": [
        "oxlint"
      ]
    }
  ]
}
