{
  "name": "codex-agent-workflows",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test:control": "bun scripts/test.ts bun",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write \"scripts/**/*.ts\"",
    "format:check": "oxfmt --check \"scripts/**/*.ts\"",
    "lint": "oxlint --deny-warnings scripts",
    "complexity": "biome lint scripts",
    "check": "bun run lint && bun run format:check && bun run complexity && bun run typecheck && bun run knowledge:check && bun run test:control",
    "knowledge:generate": "bun scripts/knowledge.ts",
    "knowledge:check": "bun scripts/knowledge.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
