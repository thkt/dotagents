{
  "name": "codex-agent-workflows",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test:control": "bun scripts/test.ts bun",
    "lint:docs": "textlint --config .textlintrc.json",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write scripts",
    "format:check": "oxfmt --check scripts",
    "lint": "oxlint --deny-warnings scripts",
    "complexity": "biome lint scripts",
    "check:unused": "bun scripts/check-unused.ts",
    "analyze:duplicates": "fallow dupes",
    "analyze:complexity": "fallow health --complexity --sort cognitive --report-only",
    "analyze:cycles": "fallow dead-code --circular-deps",
    "check": "bun run lint && bun run format:check && bun run complexity && bun run typecheck && bun run check:unused && bun run knowledge:check && bun run test:control",
    "knowledge:generate": "bun scripts/knowledge.ts",
    "knowledge:check": "bun scripts/knowledge.ts --check"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@oxlint/plugins": "1.83.0",
    "@textlint-rule/textlint-rule-no-invalid-control-character": "3.0.0",
    "@types/bun": "1.4.2",
    "fallow": "3.27.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "textlint": "15.8.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1",
    "textlint-rule-no-nfd": "2.0.2",
    "textlint-rule-no-zero-width-spaces": "1.0.1",
    "typescript": "7.0.2"
  }
}
