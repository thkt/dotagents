{
  "name": "codex-agent-workflows",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "codex-build-artifacts": "workflows/flow/build/artifacts.ts",
    "codex-build-plan": "workflows/flow/build/plan.ts",
    "codex-build-pr-body": "workflows/flow/build/pr-body.ts",
    "codex-build-revalidate": "workflows/flow/build/revalidate.ts",
    "codex-flow": "workflows/flow/runner.ts",
    "codex-issue": "workflows/issue/runner.ts",
    "codex-post-edit": "hooks/post-edit.ts",
    "codex-research": "workflows/research/runner.ts",
    "codex-think": "workflows/think/runner.ts",
    "codex-workflow-hook": "hooks/workflow-enforcer.ts"
  },
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run knip && bun run test && bun run validate:skills",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "fix:text": "textlint --fix '.ja/**/*.md'",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:text": "textlint '.ja/**/*.md'",
    "knip": "knip",
    "test": "bun test --timeout=15000 --parallel=4 --no-isolate workflows/tests skills/tests",
    "typecheck": "tsc -p tsconfig.json",
    "verify:clean": "bun install --frozen-lockfile --ignore-scripts && bun run check",
    "validate:skills": "bun skills/validate.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.149.1"
  },
  "devDependencies": {
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "@types/bun": "1.4.0",
    "@types/node": "^26.2.0",
    "knip": "^6.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "textlint": "15.8.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1",
    "textlint-rule-ja-no-weak-phrase": "2.0.0",
    "textlint-rule-preset-ja-spacing": "3.0.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "packageManager": "bun@1.4.0"
}
