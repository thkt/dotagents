{
  "name": "codex-agent-workflows",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "test:control": "bun scripts/tests/runner.ts bun",
    "lint:docs": "textlint --config .textlintrc.json",
    "typecheck": "bun --check",
    "format": "bun fmt scripts eval",
    "format:check": "bun fmt --check scripts eval",
    "lint": "oxlint --deny-warnings scripts eval",
    "complexity": "biome lint scripts eval",
    "check:unused": "bun scripts/lint/fallow.ts",
    "analyze:duplicates": "fallow dupes",
    "analyze:complexity": "fallow health --complexity --sort cognitive --report-only",
    "analyze:cycles": "fallow dead-code --circular-deps",
    "check": "bun run lint && bun run format:check && bun run complexity && bun run typecheck && bun run check:unused && bun run test:control && bun run test:eval",
    "test:eval": "bun scripts/tests/runner.ts bun eval/tests"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxlint/plugins": "1.87.0",
    "@textlint-rule/textlint-rule-no-invalid-control-character": "3.0.0",
    "@types/bun": "1.4.2",
    "fallow": "3.32.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "textlint": "15.8.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1",
    "textlint-rule-no-nfd": "2.0.2",
    "textlint-rule-no-zero-width-spaces": "1.0.1",
    "typescript": "7.0.2"
  }
}
